      "type": "object"
    },
    "evidenceValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "finding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "AUDIT_STALLED"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "audit"
              },
              "explanation": {
                "const": "Accountd is inactive or its successful poll is older than 90 seconds."
              },
              "severity": {
                "const": "WARNING"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "EXPORT_GAP"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "audit"
              },
              "explanation": {
                "const": "The local sync cursor is expired; retained remote audit history may be missing."
              },
              "severity": {
                "const": "ERROR"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "SYNC_LAG"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "audit"
              },
              "explanation": {
                "const": "Unreceived export records remain and the last successful sync is older than 300 seconds."
              },
              "severity": {
                "const": "WARNING"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "DISK_PRESSURE"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "node"
              },
              "explanation": {
                "const": "Filesystem usage is at least 90%; recovery requires usage below 85%."
              },
              "severity": {
                "const": "WARNING"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "MEMORY_PRESSURE"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "node"
              },
              "explanation": {
                "const": "Memory usage is at least 90%; recovery requires usage below 85%."
              },
              "severity": {
                "const": "WARNING"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "TELEMETRY_STALE"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "observation"
              },
              "explanation": {
                "const": "Telemetry is older than 90 seconds, replayed, or its clock is more than 30 seconds ahead."
              },
              "severity": {
                "const": "WARNING"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "SCHEMA_MISMATCH"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "audit"
              },
              "explanation": {
                "const": "The Node accounting database does not satisfy the required schema 4 contract."
              },
              "severity": {
                "const": "ERROR"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ACCOUNTING_DB_CORRUPT"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "audit"
              },
              "explanation": {
                "const": "SQLite reported accounting database corruption; audit data is not trustworthy."
              },
              "severity": {
                "const": "ERROR"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "EXPORT_SEQUENCE_REGRESSION"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "audit"
              },
              "explanation": {
                "const": "The audit export counter decreased within the same Node installation."
              },
              "severity": {
                "const": "ERROR"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "SERVICE_RESTART_LOOP"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "const": "node"
              },
              "explanation": {
                "const": "At least three automatic sing-box restarts occurred within 300 seconds."
              },
              "severity": {
                "const": "WARNING"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
