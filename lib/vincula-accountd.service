# Managed-By: vincula
# Vincula-Version: 0.5.1
[Unit]
Description=vincula local accounting daemon
Documentation=file:///usr/local/lib/vincula/vincula-accountd.py
After=sing-box.service network-online.target
Wants=sing-box.service

[Service]
Type=simple
User=vincula-accountd
Group=vincula-accountd
# Fixed privileged projection step; the long-running daemon remains unprivileged.
ExecStartPre=+/usr/bin/python3 -I /usr/local/lib/vincula/accountd_runtime.py
ExecStart=/usr/bin/python3 -I /usr/local/lib/vincula/vincula-accountd.py --runtime /etc/vincula-accountd/runtime.json
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vincula
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
