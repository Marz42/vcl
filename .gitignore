# Git ignore for Vincula

# Secrets / local env
.env
.env.*
*.pem
id_rsa*
*askpass*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.code-workspace

# Test / evidence artifacts (keep docs/evidence/ notes in-repo)
/tmp/
/evidence/
**/vcl-rc-evidence/
*.log

# Release archives (keep sources + release.lock; ignore packed tarballs)
*.tar.gz
*.tar.gz.sha256
!vincula.sh.sha256

# Local scratch
*.bak
*.tmp
.cursor/
agent-tools/

# Deploy staging copy (legacy; prefer dist/ via scripts/build-release.sh)
/release/

# Generated release artifacts (never edit by hand)
/dist/

# Live RC credential exports / bulky host mirrors (keep SUMMARY.md only)
**/creds.csv
**/credentials.csv
docs/evidence/**/remote-copy/

# Reconstructed / packed freeze artifacts
/artifacts/
*.tgz
/tmp/
