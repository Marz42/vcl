    "event": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "FINDING_OPEN",
                  "FINDING_RESOLVED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "AUDIT_STALLED",
                      "EXPORT_GAP",
                      "SYNC_LAG",
                      "DISK_PRESSURE",
                      "MEMORY_PRESSURE",
                      "TELEMETRY_STALE",
                      "SCHEMA_MISMATCH",
                      "ACCOUNTING_DB_CORRUPT",
                      "EXPORT_SEQUENCE_REGRESSION",
                      "SERVICE_RESTART_LOOP",
                      "NETWORK_RATE_ANOMALY",
                      "USER_TRAFFIC_SPIKE",
                      "USER_CONNECTION_SPIKE",
                      "SUSTAINED_TRAFFIC_ANOMALY"
                    ]
                  }
                },
                "required": [
                  "type"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SERVICE_RESTART"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "additionalProperties": false,
                "properties": {
                  "restart_delta": {
                    "maximum": 9223372036854775807,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "restart_delta"
                ],
                "type": "object"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "HEALTH_CHANGE",
                  "SERVICE_CHANGE",
                  "PROBE_RESULT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "$ref": "#/$defs/context"
              },
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "AUDIT_STALLED",
                      "EXPORT_GAP",
                      "SYNC_LAG",
                      "DISK_PRESSURE",
                      "MEMORY_PRESSURE",
                      "TELEMETRY_STALE",
                      "SCHEMA_MISMATCH",
                      "ACCOUNTING_DB_CORRUPT",
                      "EXPORT_SEQUENCE_REGRESSION",
                      "SERVICE_RESTART_LOOP",
                      "NETWORK_RATE_ANOMALY"
                    ]
                  }
                }
              },
              "kind": {
                "enum": [
                  "FINDING_OPEN",
                  "FINDING_RESOLVED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "$ref": "#/$defs/nodeSubject"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "USER_TRAFFIC_SPIKE",
                      "USER_CONNECTION_SPIKE",
                      "SUSTAINED_TRAFFIC_ANOMALY"
                    ]
                  }
                }
              },
              "kind": {
                "enum": [
                  "FINDING_OPEN",
                  "FINDING_RESOLVED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "$ref": "#/$defs/userSubject"
              }
            }
          }
        }
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "detail": {
          "type": "object"
        },
        "id": {
          "$ref": "#/$defs/hash"
        },
        "kind": {
          "enum": [
            "FINDING_OPEN",
            "FINDING_RESOLVED",
            "HEALTH_CHANGE",
            "SERVICE_CHANGE",
            "SERVICE_RESTART",
            "PROBE_RESULT"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      },
      "required": [
        "id",
        "at",
        "kind",
        "subject",
        "detail"
      ],
      "type": "object"
    },
