#!/usr/bin/env python3
"""OpenSSH stand-in for vcl-fleet tests. No network.

Selected by VCL_FLEET_SSH. Parses host/user/port like ssh, then returns
canned vcl identity/status/verify JSON, mutable per-node user state, or
simulated SSH failures.

User commands require VCL_FAKE_STATE_DIR (each alias gets users.json).
Identity/status/verify still serve canned fixtures when the state dir is
unset, matching 0.2.8 tests. Optional identity.json under the state dir
overrides the canned file. Audit export reads
{VCL_FAKE_STATE_DIR}/{alias}/accounting.db (tests create the schema 3
fixture; do not commit a binary db).
"""

from __future__ import annotations

import importlib.util
import json
import os
import re
import sqlite3
import sys
import time
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
NODES = HERE / "nodes"

FORBIDDEN = ("StrictHostKeyChecking=no", "UserKnownHostsFile=/dev/null")
KNOWN_KINDS = ("identity", "status", "verify", "user", "audit", "backup", "restore")
USER_ID_RE = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
)
TAG_RE = re.compile(r"^[a-z0-9][a-z0-9._-]{0,31}$")

# TEST-NET-3 fixtures. sg/badkey fail before any remote command.
HOST_ALIAS = {
    "203.0.113.10": "lax",
    "lax.test": "lax",
    "203.0.113.11": "tokyo",
    "tokyo.test": "tokyo",
    "203.0.113.12": "sg",
    "sg.test": "sg",
    "203.0.113.13": "badkey",
    "badkey.test": "badkey",
    "203.0.113.14": "hang",
    "hang.test": "hang",
    "203.0.113.15": "badjson",
    "badjson.test": "badjson",
    "203.0.113.16": "copied",
    "copied.test": "copied",
    "203.0.113.17": "ask",
    "ask.test": "ask",
    "203.0.113.18": "lax2",
    "lax2.test": "lax2",
}


def _utc_now() -> str:
    now = datetime.now(timezone.utc)
    skew = os.environ.get("VCL_FAKE_CLOCK_SKEW_SECONDS", "").strip()
    if skew:
        now = now + timedelta(seconds=int(skew))
    return now.strftime("%Y-%m-%dT%H:%M:%SZ")


def _parse_argv(argv: list[str]) -> tuple[str, int, list[str]]:
    host = ""
    port = 22
    remote: list[str] = []
    i = 1
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            # Destination may already have been seen; argv after -- is the remote command.
            remote = argv[i + 1 :]
            break
        if arg == "-p" and i + 1 < len(argv):
            port = int(argv[i + 1])
            i += 2
            continue
        if arg.startswith("-p") and len(arg) > 2:
            port = int(arg[2:])
            i += 1
            continue
        if arg == "-o" and i + 1 < len(argv):
            i += 2
            continue
        if arg.startswith("-o") and len(arg) > 2:
            i += 1
            continue
        if arg == "-l" and i + 1 < len(argv):
            i += 2
            continue
        if arg.startswith("-") and arg != "-":
            i += 1
            continue
        host = arg
        rest = argv[i + 1 :]
        if rest and rest[0] == "--":
            remote = rest[1:]
        else:
            remote = rest
        break
    if "@" in host:
        host = host.rsplit("@", 1)[1]
    if host.startswith("[") and host.endswith("]") and len(host) > 2:
        host = host[1:-1]
    return host, port, remote


def _remote_kind(remote: list[str]) -> tuple[str, list[str]]:
    """Classify argv after -- by remote[0:2], not substring search.

    `vcl identity` / `vcl user …` must not collapse to identity because
    the word "identity" appears (or does not) in the joined text.
    """
    args = list(remote)
    if args and args[0] == "--":
        args = args[1:]
    if args and args[0] == "vcl":
        args = args[1:]
        if not args:
            return "unknown", []
    if not args:
        return "identity", []
    kind = args[0]
    if kind in KNOWN_KINDS:
        return kind, args[1:]
    return "unknown", args


def _state_root() -> Path | None:
    raw = os.environ.get("VCL_FAKE_STATE_DIR", "").strip()
    if not raw:
        return None
    return Path(raw)


def _write_json(path: Path, data: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    tmp.replace(path)


def _emit_json(data: object) -> None:
    sys.stdout.write(json.dumps(data, ensure_ascii=False, indent=2))
    sys.stdout.write("\n")


def _load_fixture(name: str, kind: str) -> dict:
    path = NODES / name / f"{kind}.json"
    reinstall = os.environ.get("VCL_FAKE_REINSTALL", "").strip()
    if reinstall and name == "lax" and kind == "identity":
        alt = NODES / "lax" / "identity-reinstall.json"
        if alt.is_file():
            path = alt
    else:
        state = _state_root()
        if state is not None and kind == "identity":
            override = state / name / "identity.json"
            if override.is_file():
                path = override
    with path.open(encoding="utf-8") as fh:
        data = json.load(fh)
    if isinstance(data, dict) and "utc_now" in data:
        data["utc_now"] = _utc_now()
    override = os.environ.get("VCL_FAKE_INSTANCE_ID", "").strip()
    if override and isinstance(data, dict) and "instance_id" in data:
        data["instance_id"] = override
    return data


def _node_id(alias: str) -> str:
    ident = _load_fixture(alias, "identity")
    return str(ident.get("node_id") or "")


def _users_path(alias: str) -> Path:
    root = _state_root()
    if root is None:
        raise RuntimeError("VCL_FAKE_STATE_DIR is required for user commands")
    path = root / alias / "users.json"
    if not path.is_file():
        _write_json(path, {"schema_version": 2, "users": []})
    return path


def _load_users(alias: str) -> dict:
    path = _users_path(alias)
    with path.open(encoding="utf-8") as fh:
        data = json.load(fh)
    if data.get("schema_version") != 2:
        raise SystemExit("users.json must be schema_version 2")
    data.setdefault("users", [])
    return data


def _save_users(alias: str, data: dict) -> None:
    _write_json(_users_path(alias), data)


def _find_user(users: list[dict], tag: str) -> dict | None:
    for user in users:
        if user.get("tag") == tag:
            return user
    return None


def _active_credential(user: dict) -> dict | None:
    for cred in user.get("credentials") or []:
        if cred.get("status") == "active":
            return cred
    return None


def _fake_uri(credential_id: str, host: str, tag: str) -> str:
    return f"vless://{credential_id}@{host}:443?encryption=none&type=tcp#{tag}"


def _fail_aliases(env_name: str) -> set[str]:
    raw = os.environ.get(env_name, "").strip()
    if not raw:
        return set()
    return {part.strip() for part in raw.split(",") if part.strip()}


def _parse_user_flags(argv: list[str]) -> tuple[list[str], dict[str, str], bool]:
    positional: list[str] = []
    flags: dict[str, str] = {}
    as_json = False
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--json":
            as_json = True
            i += 1
            continue
        if arg in ("--user-id", "--display-name", "--department"):
            if i + 1 >= len(argv):
                raise SystemExit(f"user: {arg} requires a value")
            flags[arg[2:].replace("-", "_")] = argv[i + 1]
            i += 2
            continue
        if arg.startswith("-"):
            raise SystemExit(f"user: unknown option {arg}")
        positional.append(arg)
        i += 1
    return positional, flags, as_json


def _emit_user_add_error(error: str, user_id: str = "") -> int:
    doc: dict[str, object] = {"schema_version": 1, "ok": False, "error": error}
    if user_id:
        doc["user_id"] = user_id
    _emit_json(doc)
    return 1


def _list_json(users: list[dict]) -> dict:
    out = []
    for user in users:
        creds = user.get("credentials") or []
        active = _active_credential(user)
        out.append(
            {
                "tag": user.get("tag") or "",
                "display_name": user.get("display_name") or user.get("tag") or "",
                "department": user.get("department") or "",
                "user_id": user.get("user_id") or "",
                "enabled": bool(user.get("enabled")),
                "active_credential_id": (active or {}).get("credential_id"),
                "credentials": {
                    "count": len(creds),
                    "active": sum(1 for c in creds if c.get("status") == "active"),
                    "revoked": sum(1 for c in creds if c.get("status") == "revoked"),
                },
            }
        )
    return {"schema_version": 1, "users": out}


def _show_json(user: dict) -> dict:
    credentials = []
    for cred in user.get("credentials") or []:
        credentials.append(
            {
                "credential_id": cred.get("credential_id") or "",
                "node_id": cred.get("node_id") or "",
                "status": cred.get("status") or "",
                "created_at": cred.get("created_at") or "",
                "revoked_at": cred.get("revoked_at"),
            }
        )
    return {
        "schema_version": 1,
        "tag": user.get("tag") or "",
        "display_name": user.get("display_name") or user.get("tag") or "",
        "department": user.get("department") or "",
        "user_id": user.get("user_id") or "",
        "enabled": bool(user.get("enabled")),
        "created_at": user.get("created_at") or "",
        "credentials": credentials,
    }


def _handle_user(alias: str, host: str, argv: list[str]) -> int:
    if _state_root() is None:
        sys.stderr.write("fake-ssh: VCL_FAKE_STATE_DIR is required for user commands\n")
        return 1
    if not argv:
        sys.stderr.write("fake-ssh: unknown vcl command: vcl user\n")
        return 1

    try:
        positional, flags, _as_json = _parse_user_flags(argv[1:])
    except SystemExit as exc:
        sys.stderr.write(f"fake-ssh: {exc}\n")
        return 1

    action = argv[0]
    data = _load_users(alias)
    users = data["users"]
    now = _utc_now()
    node_id = _node_id(alias)

    if action == "add":
        if alias in _fail_aliases("VCL_FAKE_FAIL_USER_ADD"):
            return _emit_user_add_error("failed")
        if not positional:
            return _emit_user_add_error("invalid_tag")
        tag = positional[0]
        user_id = flags.get("user_id", "").strip()
        if not TAG_RE.fullmatch(tag):
            return _emit_user_add_error("invalid_tag", user_id)
        if _find_user(users, tag):
            return _emit_user_add_error("duplicate_tag", user_id)
        if not user_id:
            user_id = str(uuid.uuid4())
        elif not USER_ID_RE.fullmatch(user_id):
            return _emit_user_add_error("invalid_user_id", user_id)
        elif any(u.get("user_id") == user_id for u in users):
            return _emit_user_add_error("duplicate_user_id", user_id)
        credential_id = str(uuid.uuid4())
        vless_uuid = str(uuid.uuid4())
        display_name = flags.get("display_name") or tag
        department = flags.get("department") or ""
        users.append(
            {
                "user_id": user_id,
                "tag": tag,
                "display_name": display_name,
                "department": department,
                "enabled": True,
                "created_at": now,
                "credentials": [
                    {
                        "credential_id": credential_id,
                        "node_id": node_id,
                        "uuid": vless_uuid,
                        "status": "active",
                        "created_at": now,
                        "revoked_at": None,
                    }
                ],
            }
        )
        _save_users(alias, data)
        _emit_json(
            {
                "schema_version": 1,
                "ok": True,
                "tag": tag,
                "user_id": user_id,
                "credential_id": credential_id,
                "vless_uri": _fake_uri(credential_id, host, tag),
                "status": "active",
                "enabled": True,
            }
        )
        return 0

    if action == "list":
        _emit_json(_list_json(users))
        return 0

    if action in ("show", "enable", "disable", "rotate", "link"):
        if not positional:
            sys.stderr.write(f"fake-ssh: vcl user {action} requires a tag\n")
            return 1
        tag = positional[0]
        if not TAG_RE.fullmatch(tag):
            sys.stderr.write(f"fake-ssh: invalid user tag: {tag}\n")
            return 1
        user = _find_user(users, tag)
        if user is None:
            sys.stderr.write(f"fake-ssh: user not found: {tag}\n")
            return 1
        if action == "show":
            _emit_json(_show_json(user))
            return 0
        if action == "link":
            active = _active_credential(user)
            if active is None:
                sys.stderr.write(f"fake-ssh: user {tag} has no active credential\n")
                return 1
            sys.stdout.write(
                _fake_uri(str(active.get("credential_id") or ""), host, tag)
            )
            sys.stdout.write("\n")
            return 0
        if action == "enable":
            user["enabled"] = True
            _save_users(alias, data)
            _emit_json(
                {
                    "schema_version": 1,
                    "ok": True,
                    "tag": tag,
                    "user_id": user.get("user_id") or "",
                    "enabled": True,
                }
            )
            return 0
        if action == "disable":
            enabled_count = sum(1 for u in users if u.get("enabled"))
            if user.get("enabled") and enabled_count <= 1:
                sys.stderr.write("fake-ssh: refusing to disable the last enabled user\n")
                return 1
            user["enabled"] = False
            _save_users(alias, data)
            _emit_json(
                {
                    "schema_version": 1,
                    "ok": True,
                    "tag": tag,
                    "user_id": user.get("user_id") or "",
                    "enabled": False,
                }
            )
            return 0
        # rotate
        active = _active_credential(user)
        if active is None:
            sys.stderr.write(f"fake-ssh: user {tag} has no active credential to rotate\n")
            return 1
        active["status"] = "revoked"
        active["revoked_at"] = now
        credential_id = str(uuid.uuid4())
        user.setdefault("credentials", []).append(
            {
                "credential_id": credential_id,
                "node_id": node_id,
                "uuid": str(uuid.uuid4()),
                "status": "active",
                "created_at": now,
                "revoked_at": None,
            }
        )
        _save_users(alias, data)
        _emit_json(
            {
                "schema_version": 1,
                "ok": True,
                "tag": tag,
                "user_id": user.get("user_id") or "",
                "credential_id": credential_id,
                "vless_uri": _fake_uri(credential_id, host, tag),
                "status": "active",
                "enabled": bool(user.get("enabled")),
            }
        )
        return 0

    sys.stderr.write(f"fake-ssh: unknown vcl command: vcl user {action}\n")
    return 1


def _audit_py() -> Path:
    return HERE.parent.parent / "lib" / "vincula-audit.py"


def _backup_py() -> Path:
    return HERE.parent.parent / "lib" / "vincula-backup.py"


def _load_audit():
    path = _audit_py()
    if not path.is_file():
        return None
    spec = importlib.util.spec_from_file_location("vincula_audit_fake", path)
    if spec is None or spec.loader is None:
        return None
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _parse_export_flags(argv: list[str]) -> tuple[int, bool, int | None]:
    after: str | None = None
    jsonl = False
    limit: str | None = None
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--jsonl":
            jsonl = True
            i += 1
            continue
        if arg == "--after":
            if i + 1 >= len(argv):
                raise SystemExit("audit export --after requires EVENT_ID")
            after = argv[i + 1]
            i += 2
            continue
        if arg == "--limit":
            if i + 1 >= len(argv):
                raise SystemExit("audit export --limit requires N")
            limit = argv[i + 1]
            i += 2
            continue
        if arg.startswith("-"):
            raise SystemExit(f"audit export: unknown option {arg}")
        raise SystemExit(f"audit export: unexpected argument {arg}")
    if after is None or not jsonl:
        raise SystemExit("usage: vcl audit export --after EVENT_ID --jsonl")
    try:
        after_n = int(after)
    except ValueError as exc:
        raise SystemExit("audit export --after requires a non-negative integer") from exc
    if after_n < 0:
        raise SystemExit("audit export --after requires a non-negative integer")
    limit_n: int | None = None
    if limit is not None:
        try:
            limit_n = int(limit)
        except ValueError as exc:
            raise SystemExit("audit export --limit requires an integer >= 1") from exc
        if limit_n < 1:
            raise SystemExit("audit export --limit requires an integer >= 1")
    return after_n, jsonl, limit_n


def _inline_export_after(
    db_path: Path, after: int, limit: int | None
) -> tuple[str, list[dict], dict]:
    """Minimal JSONL export when vincula-audit.py cannot be imported."""
    keys = (
        "event_id",
        "connection_id",
        "generation",
        "user_id",
        "user_tag",
        "node_id",
        "instance_id",
        "destination_host",
        "destination_ip",
        "destination_port",
        "network",
        "upload_bytes",
        "download_bytes",
        "started_at",
        "last_seen_at",
        "closed_at",
    )
    conn = sqlite3.connect(f"file:{db_path.resolve()}?mode=ro", uri=True)
    conn.row_factory = sqlite3.Row
    try:
        row = conn.execute("SELECT MIN(event_id), MAX(event_id) FROM connections").fetchone()
        earliest = row[0] if row is not None else None
        max_event_id = row[1] if row is not None else None
        expired = after > 0 and (earliest is None or earliest > after + 1)
        meta = {
            "ok": not expired,
            "after": after,
            "earliest_available_event_id": earliest,
            "max_event_id": max_event_id,
            "count": 0,
            "node_id": None,
            "instance_id": None,
            "next_cursor": after,
        }
        if expired:
            meta["ok"] = False
            meta["error"] = "CURSOR_EXPIRED"
            return "CURSOR_EXPIRED", [], meta
        sql = (
            f"SELECT {', '.join(keys)} FROM connections WHERE event_id > ? "
            "ORDER BY event_id ASC"
        )
        params: list[object] = [after]
        if limit is not None:
            sql += " LIMIT ?"
            params.append(limit)
        rows = [{k: r[k] for k in keys} for r in conn.execute(sql, params)]
        meta["count"] = len(rows)
        meta["next_cursor"] = rows[-1]["event_id"] if rows else after
        return "ok", rows, meta
    finally:
        conn.close()


def _handle_audit(alias: str, argv: list[str]) -> int:
    fail_aliases = _fail_aliases("VCL_FAKE_FAIL_EXPORT") | _fail_aliases(
        "VCL_FAKE_FAIL_AUDIT_EXPORT"
    )
    if alias in fail_aliases:
        sys.stderr.write("fake-ssh: audit export failed\n")
        return 1
    if not argv or argv[0] != "export":
        shown = " ".join(["vcl", "audit", *argv]).strip()
        sys.stderr.write(f"fake-ssh: unimplemented: {shown}\n")
        return 1
    if _state_root() is None:
        sys.stderr.write("fake-ssh: VCL_FAKE_STATE_DIR is required for audit export\n")
        return 1

    try:
        after, _jsonl, limit = _parse_export_flags(argv[1:])
    except SystemExit as exc:
        sys.stderr.write(f"fake-ssh: {exc}\n")
        return 1

    db_path = _state_root() / alias / "accounting.db"
    if not db_path.is_file():
        sys.stderr.write(f"fake-ssh: accounting.db not found for {alias}\n")
        return 1

    ident = _load_fixture(alias, "identity")
    node_id = ident.get("node_id") or None
    instance_id = ident.get("instance_id") or None

    audit = _load_audit()
    if audit is not None:
        conn = audit.open_db_readonly(str(db_path))
        try:
            status, rows, meta = audit.export_after(conn, after, limit=limit)
        finally:
            conn.close()
    else:
        status, rows, meta = _inline_export_after(db_path, after, limit)

    meta["node_id"] = node_id
    meta["instance_id"] = instance_id
    for row in rows:
        row["node_id"] = node_id
        row["instance_id"] = instance_id

    sys.stderr.write(json.dumps(meta, separators=(",", ":")))
    sys.stderr.write("\n")
    if status == "CURSOR_EXPIRED":
        return 3
    for row in rows:
        sys.stdout.write(json.dumps(row, separators=(",", ":")))
        sys.stdout.write("\n")
    return 0


def _load_backup():
    path = _backup_py()
    if not path.is_file():
        return None
    spec = importlib.util.spec_from_file_location("vincula_backup_fake", path)
    if spec is None or spec.loader is None:
        return None
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _alias_dir(alias: str) -> Path:
    root = _state_root()
    if root is None:
        raise RuntimeError("VCL_FAKE_STATE_DIR is required")
    path = root / alias
    path.mkdir(parents=True, exist_ok=True)
    return path


def _remote_backup_path() -> str:
    return "/var/backups/vincula/backup.tar"


def _handle_backup(alias: str, argv: list[str]) -> int:
    if alias in _fail_aliases("VCL_FAKE_FAIL_BACKUP"):
        sys.stderr.write("fake-ssh: backup create failed\n")
        return 1
    if not argv or argv[0] != "create":
        shown = " ".join(["vcl", "backup", *argv]).strip()
        sys.stderr.write(f"fake-ssh: unimplemented: {shown}\n")
        return 1
    if _state_root() is None:
        sys.stderr.write("fake-ssh: VCL_FAKE_STATE_DIR is required for backup create\n")
        return 1
    if "--include-secrets" in argv:
        sys.stderr.write("fake-ssh: replace path is secretless; refusing --include-secrets\n")
        return 1
    backup = _load_backup()
    if backup is None:
        sys.stderr.write("fake-ssh: vincula-backup.py not found\n")
        return 1
    node_dir = _alias_dir(alias)
    dest = node_dir / "backup.tar"
    db = node_dir / "accounting.db"
    try:
        result = backup.create_backup(
            node_dir,
            db if db.is_file() else None,
            include_secrets=False,
            output=dest,
        )
    except SystemExit as exc:
        sys.stderr.write(f"fake-ssh: backup create failed: {exc}\n")
        return 1
    except Exception as exc:
        sys.stderr.write(f"fake-ssh: backup create failed: {exc}\n")
        return 1
    result["path"] = _remote_backup_path()
    _emit_json(result)
    return 0


def _parse_restore_flags(argv: list[str]) -> tuple[str, dict[str, str], bool]:
    positional: list[str] = []
    flags: dict[str, str] = {}
    as_json = False
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--json":
            as_json = True
            i += 1
            continue
        if arg == "--include-secrets":
            flags["include_secrets"] = "1"
            i += 1
            continue
        if arg in (
            "--replace-node",
            "--server",
            "--output",
            "--reissue-output",
            "--age-identity",
        ):
            if i + 1 >= len(argv):
                raise SystemExit(f"restore: {arg} requires a value")
            key = arg[2:].replace("-", "_")
            flags[key] = argv[i + 1]
            i += 2
            continue
        if arg.startswith("-"):
            raise SystemExit(f"restore: unknown option {arg}")
        positional.append(arg)
        i += 1
    if not positional:
        raise SystemExit("usage: vcl restore FILE --replace-node NODE_ID")
    return positional[0], flags, as_json


def _resolve_restore_archive(alias: str, remote_file: str) -> Path:
    node_dir = _alias_dir(alias)
    name = Path(remote_file).name
    candidate = node_dir / name
    if candidate.is_file():
        return candidate
    fallback = node_dir / "backup.tar"
    if fallback.is_file():
        return fallback
    raise SystemExit(f"restore archive not found: {remote_file}")


def _handle_restore(alias: str, host: str, argv: list[str]) -> int:
    if alias in _fail_aliases("VCL_FAKE_FAIL_RESTORE"):
        sys.stderr.write("fake-ssh: restore failed\n")
        return 1
    if _state_root() is None:
        sys.stderr.write("fake-ssh: VCL_FAKE_STATE_DIR is required for restore\n")
        return 1
    try:
        remote_file, flags, as_json = _parse_restore_flags(argv)
    except SystemExit as exc:
        sys.stderr.write(f"fake-ssh: {exc}\n")
        return 1
    replace_node = flags.get("replace_node", "").strip()
    if not replace_node:
        sys.stderr.write("fake-ssh: restore requires --replace-node NODE_ID\n")
        return 1
    if flags.get("include_secrets"):
        sys.stderr.write("fake-ssh: replace path is secretless; refusing --include-secrets\n")
        return 1
    backup = _load_backup()
    if backup is None:
        sys.stderr.write("fake-ssh: vincula-backup.py not found\n")
        return 1
    try:
        archive = _resolve_restore_archive(alias, remote_file)
        verified, members = backup._load_verified_members(archive, None)
        source_id = str(verified.get("source_node_id") or "")
        if replace_node != source_id:
            sys.stderr.write(
                f"ERROR: backup source_node_id {source_id} does not match "
                f"--replace-node {replace_node}.\n"
            )
            return 1
        state = json.loads(members["state.json"].decode("utf-8"))
        users = json.loads(members["users.json"].decode("utf-8"))
        config_toml = members.get("config.toml", b"").decode("utf-8")
        accounting = members.get("accounting.db")
        env_iid = os.environ.get("VCL_RESTORE_INSTANCE_ID", "").strip()
        if not env_iid:
            node = state.get("node") if isinstance(state.get("node"), dict) else {}
            env_iid = backup.mint_instance_id(
                str(node.get("node_id") or source_id)
            )
        plan = backup.build_restore_plan(
            state=state,
            users=users,
            config_toml=config_toml,
            accounting=accounting,
            manifest=verified,
            include_secrets=False,
            new_instance_id=env_iid,
            new_reality_private=os.environ.get("VCL_RESTORE_REALITY_PRIVATE")
            or "fake-restore-priv",
            new_reality_public=os.environ.get("VCL_RESTORE_REALITY_PUBLIC")
            or "fake-restore-pub",
            new_reality_short_id=os.environ.get("VCL_RESTORE_REALITY_SHORT_ID")
            or "fakesid1",
            new_clash_secret=os.environ.get("VCL_RESTORE_CLASH_SECRET")
            or "fake-clash-secret",
            target_server=flags.get("server") or host,
            project_version="0.3.0",
        )
    except SystemExit as exc:
        sys.stderr.write(f"fake-ssh: restore failed: {exc}\n")
        return 1
    except Exception as exc:
        sys.stderr.write(f"fake-ssh: restore failed: {exc}\n")
        return 1

    node_dir = _alias_dir(alias)
    node = plan["state"].get("node") if isinstance(plan["state"].get("node"), dict) else {}
    identity = {
        "schema_version": 1,
        "vincula_version": "0.3.0",
        "node_id": plan["node_id"],
        "instance_id": plan["new_instance_id"],
        "node_name": node.get("node_name") or alias,
        "utc_now": _utc_now(),
    }
    _write_json(node_dir / "identity.json", identity)
    _write_json(node_dir / "state.json", plan["state"])
    _write_json(node_dir / "users.json", plan["users"])
    (node_dir / "config.toml").write_text(str(plan["config_toml"]), encoding="utf-8")
    if plan.get("accounting") is not None:
        (node_dir / "accounting.db").write_bytes(bytes(plan["accounting"]))
    csv_remote = flags.get("output") or flags.get("reissue_output") or "/tmp/reissue.csv"
    csv_path = node_dir / Path(csv_remote).name
    if plan["reissue_rows"]:
        backup.write_reissue_csv(csv_path, plan["reissue_rows"])
    result = {
        "schema_version": 1,
        "ok": True,
        "mode": plan["mode"],
        "node_id": plan["node_id"],
        "source_instance_id": plan["source_instance_id"],
        "instance_id": plan["new_instance_id"],
        "reissue_csv": csv_remote,
        "users_reissued": len(plan["reissue_rows"]),
    }
    if as_json:
        _emit_json(result)
    else:
        sys.stdout.write(f"Restore {plan['mode']} node_id={plan['node_id']}\n")
        sys.stdout.write(f"instance_id: {plan['new_instance_id']}\n")
        sys.stdout.write(f"reissue_csv: {csv_remote}\n")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv if argv is None else argv)
    joined = " ".join(argv)
    for item in FORBIDDEN:
        if item in argv or item in joined:
            sys.stderr.write("FORBIDDEN_HOSTKEY_OPTION\n")
            return 2

    hang_s = os.environ.get("VCL_FAKE_SSH_HANG_SECONDS", "").strip()
    if hang_s:
        time.sleep(float(hang_s))

    host, port, remote = _parse_argv(argv)
    if not host:
        sys.stderr.write("fake-ssh: missing destination host\n")
        return 255

    alias = HOST_ALIAS.get(host)
    if alias is None:
        sys.stderr.write(
            f"ssh: connect to host {host} port {port}: Connection refused\n"
        )
        return 255
    if alias == "sg":
        sys.stderr.write(
            f"ssh: connect to host {host} port {port}: Connection refused\n"
        )
        return 255
    if alias == "badkey":
        sys.stderr.write("Host key verification failed.\n")
        return 255
    if alias == "ask":
        sys.stderr.write(
            f"The authenticity of host '{host} ({host})' can't be established.\n"
            "ED25519 key fingerprint is SHA256:AskFixtureNotPinned.\n"
            "Are you sure you want to continue connecting (yes/no/[fingerprint])?\n"
            "Host key verification failed.\n"
        )
        return 255
    if alias == "hang":
        time.sleep(3600)
        return 255
    if alias == "badjson":
        sys.stdout.write("this is not identity JSON\n")
        return 0

    kind, rest = _remote_kind(remote)
    if kind == "unknown":
        shown = " ".join(remote) or "(empty)"
        sys.stderr.write(f"fake-ssh: unknown vcl command: {shown}\n")
        return 1
    if kind == "audit":
        return _handle_audit(alias, rest)
    if kind == "user":
        return _handle_user(alias, host, rest)
    if kind == "backup":
        return _handle_backup(alias, rest)
    if kind == "restore":
        return _handle_restore(alias, host, rest)
    data = _load_fixture(alias, kind)
    sys.stdout.write(json.dumps(data, ensure_ascii=False, indent=2))
    sys.stdout.write("\n")
    if kind in ("status", "verify") and not data.get("ok", True):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
