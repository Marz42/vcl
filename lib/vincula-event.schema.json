{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vincula.local/schemas/connection-closed-event.json",
  "title": "Vincula connection_closed event",
  "description": "Canonical accounting event written one JSON object per line to /var/lib/vincula/events.jsonl. Used by vincula-accountd when present; preferred over Clash API poll-close snapshots.",
  "type": "object",
  "required": [
    "event",
    "connection_id",
    "node_id",
    "user",
    "upload_bytes",
    "download_bytes",
    "closed_at"
  ],
  "properties": {
    "event": {
      "const": "connection_closed"
    },
    "connection_id": {
      "type": "string",
      "description": "Opaque connection identifier from the runtime."
    },
    "node_id": {
      "type": "string",
      "description": "Vincula node identifier (config.toml node_id)."
    },
    "user": {
      "type": "string",
      "description": "User tag (auth_user / registry tag), e.g. alice."
    },
    "destination_host": {
      "type": ["string", "null"],
      "description": "SNI/host when sniffed; null when only IP is known. Do not reverse-DNS invent a host."
    },
    "destination_ip": {
      "type": ["string", "null"]
    },
    "destination_port": {
      "type": ["integer", "null"]
    },
    "network": {
      "type": ["string", "null"],
      "description": "tcp or udp"
    },
    "upload_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "download_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "started_at": {
      "type": ["string", "null"],
      "description": "RFC3339 / ISO-8601 UTC timestamp"
    },
    "closed_at": {
      "type": "string",
      "description": "RFC3339 / ISO-8601 UTC timestamp"
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "event": "connection_closed",
      "connection_id": "7f3c1a2b",
      "node_id": "6fc96a10-1111-4111-8111-111111111111",
      "user": "alice",
      "destination_host": "googlevideo.com",
      "destination_ip": "203.0.113.10",
      "destination_port": 443,
      "network": "tcp",
      "upload_bytes": 102400,
      "download_bytes": 20841022,
      "started_at": "2026-08-14T06:00:00Z",
      "closed_at": "2026-08-14T06:01:12Z"
    }
  ]
}
